# ============================================================================
# Personal OS V2 — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# Phase 1 needs only the Supabase block. The rest are for later phases.
# ============================================================================

# --- Supabase (Phase 1) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, NEVER exposed to the browser

# --- App (Phase 1) ----------------------------------------------------------
USER_TIMEZONE=UTC                   # drives all "what day is it" math

# --- AI gateway (Phase 2+) --------------------------------------------------
AI_PROVIDER=local                   # local | anthropic | openai | hybrid
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_CHAT_MODEL=llama3.1:8b        # any Ollama instruct model
LOCAL_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIM=768                   # MUST match memory_chunks.embedding vector(N)
STT_PROVIDER=none                   # none | openai (whisper; needs OPENAI_API_KEY) | local (reserved)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Telegram capture (Phase 3) --------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=          # only if using webhook mode (public URL)
# TELEGRAM_USER_ID=                 # numeric id; bot listens only to you

# --- HealthKit ingest (Phase 5) --------------------------------------------
# HEALTHKIT_INGEST_SECRET=

# --- Integrations (Phase 5+) -----------------------------------------------
# GOOGLE_CALENDAR_ICAL_URL=
# GOOGLE_SHEETS_FINANCE_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_KEY=

# --- System (Phase 4+) ------------------------------------------------------
# CRON_SECRET=

# Read-only calendar feed (§12.5) — your calendar's private/secret ICS address
# (Google: Settings → your calendar → "Secret address in iCal format").
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
